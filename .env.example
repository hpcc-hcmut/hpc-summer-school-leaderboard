# Required secrets
# Example value only. Replace before a live deployment.
# Do not reuse these values for real events.
ADMIN_PASSWORD=<change-me-admin-password>
ADMIN_JWT_SECRET=<random-jwt-secret>

# Evaluation set: public (artifact/demo), private (live event), or custom.
# For custom, also set GROUND_TRUTH_PATH and GROUND_TRUTH_QA_PATH to mounted files.
DATASETS=public

# Team tokens
# Example value only. Replace before a live deployment.
# Do not reuse these values for real events.
# Keep this file private!
TEAMS_SEED_JSON=[{"team_id":"<team-id>","team_name":"<team-name>","token":"<team-token>"}]
